{
  "name": "dsize",
  "version": "0.0.3",
  "description": "Show size of each file/folder under a given path",
  "bin": {
    "dsize": "./dist/index.js"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "start": "node dist/index.js",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "file size",
    "directory size",
    "folder size",
    "fsize"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hnxycxd/dsize.git"
  },
  "author": "chengxudong",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.9.2",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1"
  },
  "packageManager": "pnpm@11.5.0"
}
